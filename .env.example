# .env로 복사해 쓴다. 이 파일에는 실제 값을 넣지 않는다(docs/05_api_spec.md 4.2).

# DB (SPEC 3장 "로컬 DB 준비"로 만든 계정)
DATABASE_URL=mysql+asyncmy://wj:password@localhost:3306/worth_joining
DATABASE_URL_SYNC=mysql+pymysql://wj:password@localhost:3306/worth_joining
TEST_DATABASE_URL=mysql+asyncmy://wj:password@localhost:3306/worth_joining_test
DB_SSL_VERIFY=false            # false: TLS 없이 접속(로컬). true: 인증서를 검증하는 TLS(배포)

# 외부 API 키. 비어 있으면 해당 수집기는 경고 후 건너뛴다
DATA_GO_KR_SERVICE_KEY=        # 공공데이터포털 Decoding 키
SEOUL_OPENDATA_KEY=            # 서울 열린데이터광장 (전월세)
OPENDART_API_KEY=
JUSO_SEARCH_KEY=               # 주소정보누리집 검색 API
JUSO_COORD_KEY=                # 주소정보누리집 좌표제공 API
SARAMIN_ACCESS_KEY=            # 대표 1인만 보유. 다른 팀원은 비워 두고 fixture로 개발

# 프론트엔드는 web/.env.local에 둔다
# NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

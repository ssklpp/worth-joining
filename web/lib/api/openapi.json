         "type": "string",
         "pattern": "^\\d{6}$"
        },
        {
         "type": "null"
        }
       ],
       "description": "사업자번호 앞 6자리",
       "title": "Biz No6"
      },
      "description": "사업자번호 앞 6자리"
     },
     {
      "name": "industry",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^\\d{6}$"
        },
        {
         "type": "null"
        }
       ],
       "description": "업종 코드 6자리",
       "title": "Industry"
      },
      "description": "업종 코드 6자리"
